// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String           @unique
  sku           String           @unique
  description   String?
  priceCents    Int
  images        String[]
  tags          String[]
  details       Json?
  stock         Int              @default(0)
  featured      Boolean          @default(false)
  published     Boolean          @default(true)
  publishedAt   DateTime?        @default(now())
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  categoryId    String?          @db.ObjectId
  artisan       Artisan?         @relation(fields: [artisanId], references: [id])
  artisanId     String?          @db.ObjectId
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     String?
  lastUpdatedBy String?

  orderItems    OrderItem[]
  inventoryLog  ProductInventoryEvent[]
  auditLog      ProductAuditLog[]
  reviews       ProductReview[]
  wishlists     Wishlist[]
  subscriptions Subscription[]
  stockAlerts   StockAlert[]
}

model ProductCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  heroImage   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Artisan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  location  String?
  bio       String?
  photoUrl  String?
  stories   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model ProductInventoryEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId
  delta     Int
  reason    String
  createdAt DateTime @default(now())
  createdBy String?
  metadata  Json?
}

model ProductAuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  productId  String   @db.ObjectId
  action     String
  changes    Json?
  actorId    String?
  actorEmail String?
  createdAt  DateTime @default(now())
}

model Order {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  email             String
  status            OrderStatus      @default(PENDING)
  fulfillmentStage  FulfillmentStage @default(NOT_STARTED)
  subtotalCents     Int
  taxCents          Int              @default(0)
  shippingCents     Int              @default(0)
  totalCents        Int
  currency          String           @default("USD")
  stripeSessionId   String?          @unique
  stripePaymentId   String?
  trackingNumber    String?
  notes             String?
  user              User?            @relation(fields: [userId], references: [id])
  userId            String?          @db.ObjectId
  shippingAddress   Address?         @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  shippingAddressId String?          @db.ObjectId
  billingAddress    Address?         @relation("BillingAddress", fields: [billingAddressId], references: [id])
  billingAddressId  String?          @db.ObjectId
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  shipment            OrderShipment?
  couponRedemption    CouponRedemption?
  giftCardRedemption  GiftCardRedemption?
  loyaltyTransactions LoyaltyTransaction[]
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int     @default(1)
  unitPrice Int
  product   Product @relation(fields: [productId], references: [id])
  productId String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String  @db.ObjectId
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  FAILED
  REFUNDED
}

enum FulfillmentStage {
  NOT_STARTED
  PREPARING
  DISPATCHED
  DELIVERED
}

model User {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  name             String?
  email            String?             @unique
  emailVerified    DateTime?
  image            String?
  role             UserRole            @default(CUSTOMER)
  phone            String?
  createdAt        DateTime?           @default(now())
  updatedAt        DateTime?           @updatedAt
  accounts         Account[]
  sessions         Session[]
  orders           Order[]
  addresses        Address[]
  reviews          ProductReview[]
  wishlists        Wishlist[]
  subscriptions    Subscription[]
  stockAlerts      StockAlert[]
  loyaltyPoints    LoyaltyPoints?
  referrals        Referral[]          @relation("Referrer")
  referredBy       Referral[]          @relation("Referee")
  giftCards        GiftCard[]          @relation("GiftCardPurchases")
  comparisons      ProductComparison[]
  searchHistory    SearchHistory[]
  abandonedCarts   AbandonedCart[]
  CouponRedemption CouponRedemption[]
}

enum UserRole {
  ADMIN
  STAFF
  ARTISAN_MANAGER
  CUSTOMER
}

model Account {
  id                       String  @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String  @db.ObjectId
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.String
  refresh_token_expires_in Int?
  access_token             String? @db.String
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.String
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String    @unique
  userId       String    @db.ObjectId
  expires      DateTime
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  label        String?
  fullName     String
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String   @default("NP")
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?  @db.ObjectId

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")
}

model OrderStatusHistory {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  order     Order       @relation(fields: [orderId], references: [id])
  orderId   String      @db.ObjectId
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())
}

model OrderShipment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  order          Order     @relation(fields: [orderId], references: [id])
  orderId        String    @unique @db.ObjectId
  carrier        String?
  service        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CatalogImportJob {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  filename    String?
  status      ImportStatus @default(PENDING)
  createdBy   String?
  summary     Json?
  createdAt   DateTime     @default(now())
  completedAt DateTime?
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Product Reviews & Ratings
model ProductReview {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  product   Product      @relation(fields: [productId], references: [id])
  productId String       @db.ObjectId
  user      User         @relation(fields: [userId], references: [id])
  userId    String       @db.ObjectId
  rating    Int // 1-5
  title     String?
  comment   String?
  images    String[] // User-uploaded review images
  verified  Boolean      @default(false) // Verified purchase
  helpful   Int          @default(0) // Helpful votes count
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([productId, userId]) // One review per user per product
  @@index([productId, status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Wishlist/Favorites
model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// Discount Codes & Promotions
model Coupon {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  code        String     @unique
  description String?
  type        CouponType
  value       Int // Percentage (0-100) or fixed amount in cents
  minPurchase Int?       @default(0) // Minimum purchase in cents
  maxDiscount Int? // Maximum discount in cents (for percentage)
  usageLimit  Int? // Total usage limit
  usedCount   Int        @default(0)
  userLimit   Int?       @default(1) // Usage limit per user
  validFrom   DateTime
  validUntil  DateTime
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@index([code, active])
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model CouponRedemption {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  couponId  String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String   @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  discount  Int // Actual discount applied in cents
  createdAt DateTime @default(now())

  @@unique([orderId])
  @@index([couponId, userId])
}

// Gift Cards
model GiftCard {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  code           String         @unique
  amountCents    Int
  balanceCents   Int // Remaining balance
  currency       String         @default("USD")
  purchasedBy    User?          @relation("GiftCardPurchases", fields: [purchasedById], references: [id])
  purchasedById  String?        @db.ObjectId
  recipientEmail String?
  recipientName  String?
  message        String?
  status         GiftCardStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  redemptions GiftCardRedemption[]

  @@index([code, status])
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

model GiftCardRedemption {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
  giftCardId String   @db.ObjectId
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String   @db.ObjectId
  amountUsed Int // Amount used in cents
  createdAt  DateTime @default(now())

  @@unique([orderId])
}

// Subscriptions/Recurring Orders
model Subscription {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  user                 User                  @relation(fields: [userId], references: [id])
  userId               String                @db.ObjectId
  product              Product               @relation(fields: [productId], references: [id])
  productId            String                @db.ObjectId
  quantity             Int                   @default(1)
  frequency            SubscriptionFrequency
  status               SubscriptionStatus    @default(ACTIVE)
  stripeSubscriptionId String?               @unique
  nextBillingDate      DateTime
  lastBillingDate      DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId, status])
}

enum SubscriptionFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// Inventory Alerts
model StockAlert {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  product    Product   @relation(fields: [productId], references: [id])
  productId  String    @db.ObjectId
  user       User?     @relation(fields: [userId], references: [id])
  userId     String?   @db.ObjectId
  email      String
  notified   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([productId, email])
  @@index([productId, notified])
}

// Newsletter & Email Marketing
model NewsletterSubscriber {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  email          String           @unique
  name           String?
  status         SubscriberStatus @default(ACTIVE)
  source         String? // Where they subscribed from
  tags           String[] // For segmentation
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?
  lastEmailAt    DateTime?

  @@index([email, status])
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

// Loyalty Program
model LoyaltyPoints {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  user           User        @relation(fields: [userId], references: [id])
  userId         String      @unique @db.ObjectId
  points         Int         @default(0)
  tier           LoyaltyTier @default(BRONZE)
  lifetimePoints Int         @default(0)
  updatedAt      DateTime    @updatedAt

  transactions LoyaltyTransaction[]
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model LoyaltyTransaction {
  id          String                 @id @default(auto()) @map("_id") @db.ObjectId
  loyalty     LoyaltyPoints          @relation(fields: [loyaltyId], references: [id])
  loyaltyId   String                 @db.ObjectId
  points      Int // Positive for earned, negative for redeemed
  type        LoyaltyTransactionType
  order       Order?                 @relation(fields: [orderId], references: [id])
  orderId     String?                @db.ObjectId
  description String?
  createdAt   DateTime               @default(now())

  @@index([loyaltyId, createdAt])
}

enum LoyaltyTransactionType {
  EARNED_PURCHASE
  EARNED_REFERRAL
  EARNED_REVIEW
  REDEEMED
  EXPIRED
  ADJUSTMENT
}

// Referral Program
model Referral {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  referrer     User           @relation("Referrer", fields: [referrerId], references: [id])
  referrerId   String         @db.ObjectId
  referee      User?          @relation("Referee", fields: [refereeId], references: [id])
  refereeId    String?        @db.ObjectId
  refereeEmail String?
  code         String         @unique
  status       ReferralStatus @default(PENDING)
  rewardGiven  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  @@index([referrerId, status])
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REWARDED
}

// Product Comparison
model ProductComparison {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  sessionId String? // For guest comparisons
  products  String[] // Array of product IDs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

// Search History
model SearchHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  sessionId String? // For guest searches
  query     String
  results   Int // Number of results
  clicked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

// Abandoned Cart
model AbandonedCart {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?  @db.ObjectId
  email      String
  sessionId  String?
  items      Json // Cart items as JSON
  totalCents Int
  emailed    Boolean  @default(false)
  recovered  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email, emailed])
  @@index([userId])
}
